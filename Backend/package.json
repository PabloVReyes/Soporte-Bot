{
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "compilerOptions": {
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "dependencies": {
        "@prisma/client": "^6.18.0",
        "@whiskeysockets/baileys": "^7.0.0-rc.6",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "pino": "^10.1.0",
        "qrcode-terminal": "^0.12.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@types/colors": "^1.2.4",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.9.1",
        "@types/response-time": "^2.3.9",
        "@types/socket.io": "^3.0.2",
        "morgan": "^1.10.1",
        "response-time": "^2.3.4",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    }
}
